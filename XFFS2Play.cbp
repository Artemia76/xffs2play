<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="XFFS2Play" />
		<Option pch_mode="2" />
		<Option compiler="clang" />
		<Build>
			<Target title="XP11_Debug">
				<Option output="bin/XP11/Debug/lin.xpl" imp_lib="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).a" def_file="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).def" prefix_auto="0" extension_auto="0" />
				<Option object_output="obj/XP11/Debug/" />
				<Option type="3" />
				<Option compiler="clang" />
				<Compiler>
					<Add option="-g" />
					<Add option="-DXFFS_DEBUG" />
					<Add option="-DXPLM300" />
					<Add option="-DXPLM301" />
					<Add directory="$(#xplane11_sdk.INCLUDE)/XPLM" />
					<Add directory="$(#xplane11_sdk.INCLUDE)/Widgets" />
					<Add directory="$(#xplane11_sdk.INCLUDE)/Wrappers" />
					<Add directory="sim" />
					<Add directory="build" />
					<Add directory="tools" />
				</Compiler>
			</Target>
			<Target title="XP11_Release">
				<Option output="bin/XP11/Release/lin.xpl" imp_lib="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).a" def_file="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).def" prefix_auto="0" extension_auto="0" />
				<Option object_output="obj/XP11/Release/" />
				<Option type="3" />
				<Option compiler="clang" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-DXPLM300" />
					<Add option="-DXPLM301" />
					<Add directory="$(#xplane11_sdk.INCLUDE)/XPLM" />
					<Add directory="$(#xplane11_sdk.INCLUDE)/Widgets" />
					<Add directory="$(#xplane11_sdk.INCLUDE)/Wrappers" />
					<Add directory="sim" />
					<Add directory="tools" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
			<Target title="XP10_Debug">
				<Option output="bin/XP10/Debug/lin.xpl" imp_lib="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).a" def_file="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).def" prefix_auto="0" extension_auto="0" />
				<Option object_output="obj/XP10/Debug/" />
				<Option type="3" />
				<Option compiler="clang" />
				<Compiler>
					<Add option="-g" />
					<Add option="-DXFFS_DEBUG" />
					<Add directory="sim" />
					<Add directory="$(#xplane10_sdk.INCLUDE)/XPLM" />
					<Add directory="$(#xplane10_sdk.INCLUDE)/Widgets" />
					<Add directory="$(#xplane10_sdk.INCLUDE)/Wrappers" />
					<Add directory="tools" />
				</Compiler>
			</Target>
			<Target title="XP10_Release">
				<Option output="bin/XP10/Release/lin.xpl" imp_lib="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).a" def_file="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).def" prefix_auto="0" extension_auto="0" />
				<Option object_output="obj/XP10/Release/" />
				<Option type="3" />
				<Option compiler="clang" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="sim" />
					<Add directory="$(#xplane10_sdk.INCLUDE)/XPLM" />
					<Add directory="$(#xplane10_sdk.INCLUDE)/Widgets" />
					<Add directory="$(#xplane10_sdk.INCLUDE)/Wrappers" />
					<Add directory="tools" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-std=c++11" />
			<Add option="-fPIC" />
			<Add option="-shared -rdynamic -nodefaultlibs -undefined_warning -Qunused-arguments" />
			<Add option="`pkg-config --cflags protobuf`" />
			<Add option="-DXPLM200" />
			<Add option="-DXPLM210" />
			<Add option="-DLIN=1" />
			<Add directory="./" />
			<Add directory="/usr/include/boost" />
		</Compiler>
		<Linker>
			<Add option="`pkg-config --libs protobuf`" />
			<Add library="boost_system" />
		</Linker>
		<Unit filename="gui/mainframe.cpp" />
		<Unit filename="gui/mainframe.h" />
		<Unit filename="net/udpserver.cpp" />
		<Unit filename="net/udpserver.h" />
		<Unit filename="proto/aircraftstate.proto" />
		<Unit filename="sim/aircraft.cpp" />
		<Unit filename="sim/aircraft.h" />
		<Unit filename="sim/aircraftstate.cpp" />
		<Unit filename="sim/aircraftstate.h" />
		<Unit filename="sim/simcontroller.cpp" />
		<Unit filename="sim/simcontroller.h" />
		<Unit filename="sim/useraircraft.cpp" />
		<Unit filename="sim/useraircraft.h" />
		<Unit filename="tools/datetime.cpp" />
		<Unit filename="tools/datetime.h" />
		<Unit filename="tools/hexa.h" />
		<Unit filename="tools/log.cpp" />
		<Unit filename="tools/log.h" />
		<Unit filename="tools/simple_file_parser.cpp" />
		<Unit filename="tools/simple_file_parser.h" />
		<Unit filename="tools/utils3d.h" />
		<Unit filename="tools/version.h" />
		<Unit filename="xpmain.cpp" />
		<Unit filename="xpmain.h" />
		<Extensions>
			<envvars set="xffs2play" />
			<code_completion />
			<debugger />
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
