<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="XFFS2Play" />
		<Option pch_mode="2" />
		<Option compiler="clang" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/lin.xpl" imp_lib="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).a" def_file="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).def" prefix_auto="0" extension_auto="0" />
				<Option object_output="obj/Debug/" />
				<Option type="3" />
				<Option compiler="clang" />
				<Option createDefFile="1" />
				<Option createStaticLib="1" />
				<Compiler>
					<Add option="-g" />
					<Add option="-DXFFS_DEBUG" />
				</Compiler>
				<Linker>
					<Add library="boost_system" />
					<Add library="pthread" />
					<Add library="protobuf" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/lin.xpl" imp_lib="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).a" def_file="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).def" prefix_auto="0" extension_auto="0" />
				<Option object_output="obj/Release/" />
				<Option type="3" />
				<Option compiler="clang" />
				<Option createDefFile="1" />
				<Option createStaticLib="1" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add library="boost_system" />
					<Add library="pthread" />
					<Add library="protobuf" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-fPIC" />
			<Add option="-Wall" />
			<Add option="-std=c++11" />
			<Add option="-std=c11" />
			<Add option="-shared -rdynamic -nodefaultlibs -undefined_warning" />
			<Add option="-DXPLM200" />
			<Add option="-DXPLM300" />
			<Add option="-DLIN=1" />
			<Add directory="./" />
			<Add directory="/home/gianni/projet/XPSDK300/CHeaders/XPLM" />
			<Add directory="/home/gianni/projet/XPSDK300/CHeaders/Wrappers" />
			<Add directory="/usr/include/boost" />
		</Compiler>
		<ExtraCommands>
			<Add before="protoc --cpp_out ./ ./net/aircraftstate.proto" />
			<Mode after="always" />
		</ExtraCommands>
		<Unit filename="gui/mainframe.cpp" />
		<Unit filename="gui/mainframe.h" />
		<Unit filename="net/aircraftstate.pb.cc" />
		<Unit filename="net/aircraftstate.pb.h" />
		<Unit filename="net/aircraftstate.proto" />
		<Unit filename="net/udpserver.cpp" />
		<Unit filename="net/udpserver.h" />
		<Unit filename="sim/aircraftstate.cpp" />
		<Unit filename="sim/aircraftstate.h" />
		<Unit filename="sim/simcontroller.cpp" />
		<Unit filename="sim/simcontroller.h" />
		<Unit filename="tools/datetime.cpp" />
		<Unit filename="tools/datetime.h" />
		<Unit filename="tools/hexa.h" />
		<Unit filename="tools/log.cpp" />
		<Unit filename="tools/log.h" />
		<Unit filename="xpmain.cpp" />
		<Extensions>
			<envvars />
			<code_completion />
			<debugger />
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
